{
  "name": "module-image-capture",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "test:native": "node scripts/native-smoke.mjs",
    "format": "prettier --write entrypoints lib scripts tests wxt.config.ts vitest.config.ts package.json tsconfig.json",
    "format:check": "prettier --check entrypoints lib scripts tests wxt.config.ts vitest.config.ts package.json tsconfig.json",
    "fixtures": "node scripts/fixture-server.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "^1.1.3",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wxt": "^0.21.0"
  }
}
